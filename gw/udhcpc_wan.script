#!/bin/sh
# udhcpc_wan.sh v1.0 (=local udhcpc_wan.script) -- event hook for wan_policy2.
# v1.2 of wan_policy2 made the WAN interface configurable (WAN_IF=eth0);
# this hook is interface-agnostic: uses udhcpc's own $interface env.
# Writes /tmp/wan.gw; dual-WAN policy itself lives in wan_policy2.sh.
case "$1" in
bound|renew)
    ip addr flush dev "$interface" 2>/dev/null
    PFX=24
    case "$subnet" in
        255.255.255.0) PFX=24;;
        255.255.255.128) PFX=25;;
        255.255.254.0) PFX=23;;
        255.255.0.0) PFX=16;;
    esac
    ip addr add "$ip/$PFX" dev "$interface" 2>/dev/null
    echo "$router" > /tmp/wan.gw
    echo "$(date) lease $ip/$PFX gw $router dev $interface" >> /tmp/udhcpc_wan.log
    ;;
deconfig)
    ip addr flush dev "$interface" 2>/dev/null
    ;;
esac
exit 0
